# انسخ هذا الملف إلى .env.local وعبّ القيم. لا ترفع .env.local على GitHub.

# رمز الدخول للوحة التحكم (يُستخدم إذا ما كان محفوظ في Firestore)
LOGIN_PIN=

# مفتاح Gemini للمساعد الذكي وتوقع المبيعات: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# للتشغيل على جهازك فقط: مسار ملف حساب الخدمة (Service Account) من Firebase
# لأن الخادم يستخدم Firebase Admin. في الاستضافة على Firebase ما تحتاجه.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
