
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public write only for new support ticket attachments.
    // The path must match what's generated in the client-side code.
    match /support_tickets/{ticketId}/{fileName} {
      allow write: if request.auth == null || request.auth != null; // Public can create
      allow read, delete: if request.auth != null && request.auth.token.admin == true; // Admin can manage
    }

    // Secure all other paths. Only admin can read/write.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
