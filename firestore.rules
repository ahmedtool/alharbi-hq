
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السماح بالقراءة العامة للإعدادات الأساسية
    // مستند "security" فيه رمز الدخول، فما يُقرأ إلا للمسجّلين (والخادم يقرأه عبر Admin SDK)
    match /app_config/{docId} {
      allow read: if docId != 'security' || request.auth != null;
      allow write: if request.auth != null;
    }

    // السماح بالقراءة العامة للروابط المرقمة للوصول السريع
    match /numbered_links/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // تأمين جميع المجموعات الأخرى للمسؤول فقط
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
