{
  "name": "ahmed-alharbi-desktop",
  "productName": "أحمد الحربي",
  "version": "1.0.0",
  "description": "لوحة تحكم أحمد الحربي كتطبيق ويندوز",
  "author": "Ahmed Alharbi",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "resedit": "2.0.3"
  },
  "build": {
    "appId": "com.ahmedalharbi.dashboard",
    "productName": "أحمد الحربي",
    "executableName": "AhmedAlharbi",
    "artifactName": "AhmedAlharbi-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "afterPack": "./after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "أحمد الحربي",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1025"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedtool/alharbi-hq"
  }
}